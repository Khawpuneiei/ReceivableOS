# Copy to .env and fill in. Never commit .env.

# Service URLs (orchestrator calls the others; run_demo.py calls the orchestrator)
ORCHESTRATOR_URL=http://localhost:8000
OCR_URL=http://localhost:8001
POLICY_URL=http://localhost:8002
WALLET_URL=http://localhost:8003

# LLM client (pluggable; each service reads these through its llm_client)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=replace-me

# Settlement token: tTHB (simulated baht, default) or mUSDC (mock USDC). Pending P's choice.
SETTLEMENT_TOKEN=tTHB

# Chain: mock (default, no node needed) or fisco. Kept generic so the backend can be swapped.
CHAIN_MODE=mock
CHAIN_RPC_URL=http://127.0.0.1:20200
CHAIN_GROUP_ID=group0
CHAIN_ACCOUNT_KEY_PATH=./accounts/agent.pem
CHAIN_DEPLOYMENTS_FILE=./services/agent-wallet/contracts/deployments.json

# Wallet guardrails, in THB with 2 decimals (demo defaults; the mandate can tighten these)
WALLET_CURRENCY=THB
WALLET_AMOUNT_DECIMALS=2
WALLET_MAX_TX_AMOUNT=1500000.00
WALLET_DAILY_CAP=3000000.00
# draws at or above this go to pending_approval and need POST /wallet/confirm/{tx_id}
WALLET_HUMAN_REVIEW_ABOVE=837500.00
WALLET_PAYEE_ALLOWLIST=0xSUPPLIER

# Invoice fingerprint: HMAC-SHA256 key. Every service that computes fingerprints must use the same value.
# Unset in dev means a fixed dev key plus a warning. Use a long random value for the demo.
FINGERPRINT_HMAC_KEY=replace-with-a-long-random-string
