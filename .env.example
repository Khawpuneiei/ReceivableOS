# Copy to .env and fill in. Never commit .env.

# Service URLs (used by integration/run_demo.py and by services calling each other)
OCR_URL=http://localhost:8001
POLICY_URL=http://localhost:8002
WALLET_URL=http://localhost:8003

# LLM client (pluggable; each service reads these)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=replace-me

# Ledger: mock (default, no chain needed) or fisco
LEDGER_MODE=mock
FISCO_NODE_URL=http://127.0.0.1:20200
FISCO_GROUP_ID=group0
FISCO_ACCOUNT_KEY_PATH=./services/agent-wallet/accounts/agent.pem
FISCO_GUARD_CONTRACT_ADDRESS=
FISCO_VAULT_CONTRACT_ADDRESS=

# Wallet guardrails (defaults for the demo)
WALLET_MAX_TX_AMOUNT=10000
WALLET_PAYEE_ALLOWLIST=0xSUPPLIER
WALLET_HUMAN_APPROVAL_OVER=5000
