{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SalorWorks/shopify-invoice-test-pack/schema/expected.schema.json",
  "title": "Synthetic supplier invoice ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureId",
    "supplier",
    "invoiceNumber",
    "invoiceDate",
    "currency",
    "subtotal",
    "discount",
    "tax",
    "freight",
    "duty",
    "total",
    "lines"
  ],
  "properties": {
    "fixtureId": { "type": "string" },
    "title": { "type": "string" },
    "tests": { "type": "string" },
    "language": { "type": "string" },
    "direction": { "enum": ["ltr", "rtl"] },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "address": { "type": "string" },
        "taxRegistration": { "type": ["string", "null"] }
      }
    },
    "billTo": { "type": "string" },
    "invoiceNumber": { "type": "string" },
    "invoiceDate": { "type": "string", "format": "date" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "merchantCurrency": { "type": "string" },
    "taxLabel": { "type": ["string", "null"] },
    "taxRate": { "type": ["number", "null"] },
    "subtotal": { "type": "number" },
    "discount": { "type": "number" },
    "tax": { "type": "number" },
    "freight": { "type": "number" },
    "duty": { "type": "number" },
    "total": { "type": "number" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unit", "unitPrice", "lineTotal"],
        "properties": {
          "description": { "type": "string" },
          "descriptionArabic": { "type": "string" },
          "supplierSku": { "type": ["string", "null"] },
          "barcode": { "type": ["string", "null"] },
          "quantity": { "type": "number" },
          "deliveredQuantity": { "type": "number" },
          "freeOfChargeQuantity": { "type": "number" },
          "unit": { "type": "string" },
          "unitPrice": { "type": "number" },
          "discount": { "type": "number" },
          "tax": { "type": "number" },
          "lineTotal": { "type": "number" },
          "pack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unitsPerCase": { "type": "number" },
              "shopifyQuantity": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
