# Run scripts/setup_local.py to create private random keys in ignored .env.local.
FINGERPRINT_HMAC_KEY=
BANK_TOKEN_HMAC_KEY=
# Private header token for GET /ocr/invoices/{id}; generated by setup_local.py.
OCR_RESULT_ACCESS_TOKEN=
# Optional hosted vision candidate check; leave API key empty for offline rules extraction.
# Only Anthropic Messages is currently supported. Choose an available vision-capable model explicitly.
OCR_HOSTED_VISION_ENABLED=0
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
OCR_PADDLE_ENABLED=0
OCR_QWEN_ENABLED=0
OCR_QWEN_URL=http://127.0.0.1:11434
OCR_QWEN_MODEL=qwen3-vl:4b-instruct
# Set both to existing directories after explicit model staging.
OCR_PADDLE_DET_DIR=
OCR_PADDLE_REC_DIR=
# Must match the staged directory: en_PP-OCRv5_mobile_rec, th_PP-OCRv5_mobile_rec,
# or PP-OCRv5_mobile_rec (Chinese recognition experiment; field extraction still unsupported).
OCR_PADDLE_REC_NAME=en_PP-OCRv5_mobile_rec
# Set 1 only for fictional demo data: public-key fallback + exact legacy text fixture.
OCR_DEVELOPMENT_MODE=0
OCR_ALLOW_RESET=0
