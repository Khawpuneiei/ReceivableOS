# Run scripts/setup_local.py to create private random keys in ignored .env.local.
FINGERPRINT_HMAC_KEY=
BANK_TOKEN_HMAC_KEY=
OCR_PADDLE_ENABLED=0
OCR_QWEN_ENABLED=0
OCR_QWEN_URL=http://127.0.0.1:11434
OCR_QWEN_MODEL=qwen3-vl:4b-instruct
# Set both to existing directories after explicit model staging.
OCR_PADDLE_DET_DIR=
OCR_PADDLE_REC_DIR=
# Must match the staged directory: en_PP-OCRv5_mobile_rec, th_PP-OCRv5_mobile_rec,
# or PP-OCRv5_mobile_rec (Chinese recognition experiment; field extraction still unsupported).
OCR_PADDLE_REC_NAME=en_PP-OCRv5_mobile_rec
OCR_DEVELOPMENT_MODE=0
OCR_ALLOW_RESET=0
