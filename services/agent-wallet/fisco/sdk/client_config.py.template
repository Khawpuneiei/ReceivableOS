    gm_account_password = None
    solc_path = None
    solcjs_path = None
    gm_solc_path = None
    background = True
    bcos3_lib_path = "/opt/python-sdk/bcos3sdklib"
    bcos3_config_file = "/work/sdk/bcos3_sdk_config.ini"
    bcos3_group = "group0"
    bcos3_check_node_version = True
    bcos3_when_version_mismatch = "WARN"
    bcos3_major_version = 3
    bcos3_max_miner_version = 6
    PROTOCOL_RPC = "rpc"
    PROTOCOL_CHANNEL = "channel"
    fiscoChainId = 1
