    ssl_type = crypto_type
    set_crypto_type(crypto_type)
    logdir = "/work/sdk/logs"
    contract_dir = "/work/sdk/contracts"
    contract_info_file = "/work/sdk/contract.ini"
    account_keyfile_path = "/work/accounts"
